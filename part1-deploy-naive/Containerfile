# Workspace image for the Summit 2026 coding-agent training (serving side only).
FROM anyscale/ray-llm:2.57.0-py312-cu130

# 2.57.0 ships vLLM 0.25.x, which already accepts Claude Code's /v1/messages schema -- no vLLM pin
# needed (2.56.0 shipped 0.22.0 and had to be forced to 0.23.0). runai is for Part 3.
RUN pip install --no-cache-dir runai-model-streamer runai-model-streamer-s3

# Direct streaming: exposes /v1/messages + /v1/responses + /v1/chat/completions.
ENV RAY_SERVE_ENABLE_HA_PROXY=1 \
    RAY_SERVE_LLM_ENABLE_DIRECT_STREAMING=1
